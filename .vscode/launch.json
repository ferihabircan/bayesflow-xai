{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run: diagnostics",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_diagnostics.py",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "Run: XAI (lambd)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_xai.py",
      "args": ["--target", "lambd"],
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "Run: full pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_all.py",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    }
  ]
}
